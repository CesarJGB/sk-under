{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sk-under.local/schemas/catalog.schema.json",
  "title": "Catálogo normalizado de Soul Knight",
  "type": "object",
  "required": [
    "schema",
    "family",
    "title",
    "game_version",
    "generated_by",
    "source_refs",
    "count",
    "items"
  ],
  "properties": {
    "schema": {"const": "sk-knowledge/catalog@1"},
    "family": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "game_version": {"type": "string", "minLength": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1},
    "license_note": {"type": ["string", "null"]},
    "count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "evidence", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {
            "type": "object",
            "required": ["en", "es"],
            "properties": {
              "en": {"type": ["string", "null"]},
              "es": {"type": ["string", "null"]},
              "zh_cn": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "category": {"type": "string", "minLength": 1},
          "subcategory": {"type": ["string", "null"]},
          "attributes": {"type": "object"},
          "relations": {"type": "object"},
          "save_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "string", "enum": ["H", "E1", "E2", "E3", "E4"]},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}