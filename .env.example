# API · Desarrollo local explícito. En producción usa SK_ENV=production.
SK_ENV=development
SK_ACCESS_TOKEN=
SK_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SK_MAX_FILE_BYTES=1048576

# API · Opcional. Configura los tres valores únicamente en el backend.
SK_SAVE_GENERAL_KEY_HEX=
SK_SAVE_STATISTICS_KEY_HEX=
SK_SAVE_IV_HEX=

# Frontend · Este valor es público y se incorpora durante el build.
VITE_API_BASE_URL=http://127.0.0.1:8017

# Laboratorio administrativo · sesión de laboratorio opcional, independiente de las cuentas.
# La escritura administrativa exige además SK_CLOUD_ADMIN_TOKEN.
SK_CLOUD_SESSION_TOKEN=
SK_CLOUD_UNIQUE_ID=
SK_CLOUD_DISTRO_ID=
SK_CLOUD_ADMIN_TOKEN=
# Interruptor compartido. Las cuentas vinculadas también requieren permiso individual.
SK_CLOUD_WRITE_ENABLED=false
# Ruta absoluta fuera del repositorio. Si se omite:
# ~/.local/share/sk-under/backups
# SK_CLOUD_BACKUP_DIR=/ruta/privada/sk-under/backups

# Cuentas vinculadas · clave externa (32 bytes aleatorios en hex) y origen HTTPS
# del editor, sin ruta ni barra final, incluido en SK_ALLOWED_ORIGINS.
SK_CLOUD_ACCOUNTS_KEY=
SK_CLOUD_ACCOUNTS_ORIGIN=
# SK_CLOUD_ACCOUNTS_DIR=/ruta/privada/sk-under/accounts

# Autenticación nativa · Fase 6.9. Deshabilitada por defecto.
SK_NATIVE_AUTH_ENABLED=false
# Escritura nativa: exige además autorización por perfil. Nunca se activa desde el navegador.
SK_NATIVE_WRITE_ENABLED=false
# Clave externa del almacén cifrado de perfiles y sesiones (32 bytes aleatorios en hex).
# Genérala con: openssl rand -hex 32
SK_NATIVE_STORE_KEY=
# Clave opcional para cifrar los respaldos nativos. Si se omite, se deriva de
# SK_NATIVE_STORE_KEY con HMAC-SHA-256 y un dominio distinto.
# SK_NATIVE_BACKUP_KEY=
# Genera un par de instalación nuevo por cuenta en el primer acceso. El usuario
# solo aporta correo, contraseña y distribución; no hay aprovisionamiento previo.
SK_NATIVE_AUTO_IDENTITY=true
# No autoriza escritura automáticamente: la edición remota sigue siendo opt-in.
SK_NATIVE_AUTO_ALLOW_WRITE=false
# Consulta el portal oficial de cuentas para recuperar el distro del jugador
# existente. Sin esta consulta, una instalación nueva crea un jugador vacío.
SK_NATIVE_PORTAL_ENABLED=true
# Rutas absolutas privadas fuera del repositorio. En Docker: /var/lib/sk-under/...
# SK_NATIVE_STORE_DIR=/ruta/privada/sk-under/native
# SK_NATIVE_BACKUP_DIR=/ruta/privada/sk-under/native-backups
# Origen HTTPS exacto del editor. Si se omite, se usa SK_CLOUD_ACCOUNTS_ORIGIN.
SK_NATIVE_ORIGIN=
# Perfil administrativo inicial Android Global (opcional; solo diagnóstico o
# migración). El flujo normal no lo necesita. Valores privados.
# También se puede aprovisionar con: python -m app.native.provision
SK_NATIVE_DISTRO_ID=
SK_NATIVE_UNIQUE_ID=
SK_NATIVE_PROFILE_LABEL=Instalación Android Global
SK_NATIVE_PROFILE_ALLOW_WRITE=false
SK_NATIVE_IDLE_SECONDS=1800
SK_NATIVE_LOGIN_ATTEMPTS=5
SK_NATIVE_LOGIN_WINDOW_SECONDS=900
# IPs/CIDR de proxies de confianza (Coolify/Traefik). Separados por comas o JSON.
# Si está vacío, X-Forwarded-For se ignora y se usa la IP del socket.
# SK_NATIVE_TRUSTED_PROXIES=172.16.0.0/12
